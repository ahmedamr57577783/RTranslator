+package nie.translator.rtranslator.tools;
+
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import nie.translator.rtranslator.Global;
+
+/**
+ * Custom military terminology glossary (English <-> Arabic).
+ * Loaded from assets/military_glossary.tsv (columns: english, arabic, category).
+ * Provides:
+ *  - exactTranslate(): whole-phrase exact match, bypassing the neural model
+ *  - maskText()/unmask(): in-sentence placeholder substitution so the neural
+ *    model keeps our preferred translation for known terms
+ */
+public class CustomGlossary {
+    private static final String TAG = "CustomGlossary";
+    private static final int MAX_TERMS_PER_TEXT = 20;
+
+    private static volatile boolean loaded = false;
+    private static final Map<String, String> enToAr = new LinkedHashMap<>();
+    private static final Map<String, String> arToEn = new LinkedHashMap<>();
+    private static final List<String> enTermsSorted = new ArrayList<>();
+    private static final List<String> arTermsSorted = new ArrayList<>();
+
+    public static synchronized void load(Global global) {
+        if (loaded || global == null) return;
+        try {
+            InputStream is = global.getAssets().open("military_glossary.tsv");
+            BufferedReader reader = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8));
+            String line;
+            while ((line = reader.readLine()) != null) {
+                line = line.trim();
+                if (line.isEmpty() || line.startsWith("#")) continue;
+                String[] parts = line.split("\t");
+                if (parts.length < 2) continue;
+                String en = parts[0].trim();
+                String ar = parts[1].trim();
+                if (en.isEmpty() || ar.isEmpty() || en.equalsIgnoreCase("en")) continue;
+                enToAr.put(normEn(en), ar);
+                arToEn.put(normAr(ar), en);
+            }
+            reader.close();
+            enTermsSorted.addAll(enToAr.keySet());
+            arTermsSorted.addAll(arToEn.keySet());
+            // longest first so multi-word terms win over their sub-terms
+            enTermsSorted.sort((a, b) -> b.length() - a.length());
+            arTermsSorted.sort((a, b) -> b.length() - a.length());
+            loaded = true;
+            Log.i(TAG, "military glossary loaded: " + enToAr.size() + " terms");
+        } catch (Exception e) {
+            e.printStackTrace();
+            loaded = true;  // never block translation on glossary problems
+        }
+    }
+
+    private static boolean isEn(CustomLocale lang) {
+        return lang != null && "eng".equalsIgnoreCase(lang.getISO3Language());
+    }
+
+    private static boolean isAr(CustomLocale lang) {
+        if (lang == null) return false;
+        String code = lang.getISO3Language();
+        return code != null && code.toLowerCase(Locale.ROOT).startsWith("ar");
+    }
+
+    private static String stripEdgePunctuation(String s) {
+        return s.replaceAll("^[\\p{Punct}\\u061F\\u060C\\u061B]+", "").replaceAll("[\\p{Punct}\\u061F\\u060C\\u061B]+$", "").trim();
+    }
+
+    private static String normEn(String s) {
+        String t = TextTools.normalizeText(s);
+        if (t == null) return "";
+        return stripEdgePunctuation(t.toLowerCase(Locale.ROOT));
+    }
+
+    private static String normAr(String s) {
+        String t = TextTools.normalizeText(s);
+        if (t == null) return "";
+        t = t.replace("\u0640", "");                              // tatweel
+        t = t.replaceAll("[\u064B-\u0652\u0670]", "");           // diacritics
+        t = t.replaceAll("[\u0623\u0625\u0622\u0671]", "\u0627"); // alef variants
+        t = t.replace("\u0649", "\u064A").replace("\u0629", "\u0647"); // common spelling variants
+        return stripEdgePunctuation(t);
+    }
+
+    /** Whole-phrase exact translation. Returns null when there is no exact match. */
+    public static String exactTranslate(Global global, String text, CustomLocale srcLang, CustomLocale tgtLang) {
+        load(global);
+        if (text == null) return null;
+        if (isEn(srcLang) && isAr(tgtLang)) {
+            return enToAr.get(normEn(text));
+        } else if (isAr(srcLang) && isEn(tgtLang)) {
+            return arToEn.get(normAr(text));
+        }
+        return null;
+    }
+
+    /**
+     * Replaces known terms in text with placeholders (MILTERM0X, MILTERM1X, ...)
+     * and fills outMask with placeholder -> translation in the target language.
+     * Returns the (possibly) modified text.
+     */
+    public static String maskText(Global global, String text, CustomLocale srcLang, CustomLocale tgtLang, Map<String, String> outMask) {
+        load(global);
+        if (text == null || outMask == null) return text;
+        boolean en = isEn(srcLang) && isAr(tgtLang);
+        boolean ar = isAr(srcLang) && isEn(tgtLang);
+        if (!en && !ar) return text;
+
+        String result = ar ? normArKeepPunctuation(text) : text;
+        List<String> terms = en ? enTermsSorted : arTermsSorted;
+        int index = outMask.size();
+        for (String term : terms) {
+            if (index >= MAX_TERMS_PER_TEXT) break;
+            String target = en ? enToAr.get(term) : arToEn.get(term);
+            if (target == null) continue;
+            String placeholder = "MILTERM" + index + "X";
+            String replaced = replaceTerm(result, term, placeholder, en);
+            if (!replaced.equals(result)) {
+                outMask.put(placeholder, target);
+                result = replaced;
+                index++;
+            }
+        }
+        return result;
+    }
+
+    private static String normArKeepPunctuation(String s) {
+        String t = s.replace("\u0640", "");
+        t = t.replaceAll("[\u064B-\u0652\u0670]", "");
+        t = t.replaceAll("[\u0623\u0625\u0622\u0671]", "\u0627");
+        t = t.replace("\u0649", "\u064A").replace("\u0629", "\u0647");
+        return t;
+    }
+
+    private static String replaceTerm(String text, String term, String replacement, boolean en) {
+        try {
+            Pattern p;
+            if (en) {
+                p = Pattern.compile("(?<![A-Za-z])" + Pattern.quote(term) + "(?![A-Za-z])",
+                        Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE);
+            } else {
+                p = Pattern.compile("(?<![\\u0600-\\u06FF])" + Pattern.quote(term) + "(?![\\u0600-\\u06FF])");
+            }
+            return p.matcher(text).replaceAll(Matcher.quoteReplacement(replacement));
+        } catch (Exception e) {
+            return text;
+        }
+    }
+
+    /**
+     * Restores placeholders in the translated output with the target-language
+     * terms. Tolerates whitespace/case changes introduced by detokenization.
+     * Unknown leftovers are removed so the user never sees raw placeholders.
+     */
+    public static String unmask(String output, Map<String, String> maskMap) {
+        if (output == null || maskMap == null || maskMap.isEmpty()) return output;
+        String result = output;
+        for (Map.Entry<String, String> e : maskMap.entrySet()) {
+            StringBuilder rx = new StringBuilder("(?i)");
+            for (char c : e.getKey().toCharArray()) {
+                rx.append(Pattern.quote(String.valueOf(c))).append("\\s*");
+            }
+            try {
+                result = Pattern.compile(rx.toString()).matcher(result)
+                        .replaceAll(Matcher.quoteReplacement(e.getValue() + " "));
+            } catch (Exception ex) {
+                // keep going with the other placeholders
+            }
+        }
+        result = result.replaceAll("(?i)M\\s*I\\s*L\\s*T\\s*E\\s*R\\s*M\\s*\\d+\\s*X?", "");
+        return result.replaceAll(" {2,}", " ").trim();
+    }
+}
