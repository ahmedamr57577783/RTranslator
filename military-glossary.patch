+    //[MIL-GLOSSARY] whole-phrase exact military glossary translation; returns true if it handled the text
+    private boolean performGlossaryExact(final String textToTranslate, final CustomLocale inputLanguage, final CustomLocale outputLanguage, boolean saveResults, @Nullable final TranslateListener responseListener) {
